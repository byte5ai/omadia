# ----------------------------------------------------------------------------
# Omadia middleware configuration
# Copy to `.env` and fill in the values you need.
#
# Channel-, integration-, and agent-specific credentials (e.g. Odoo, Teams,
# Confluence) live inside their plugin packages and are configured through
# the admin UI's plugin setup form — NOT here.
# ----------------------------------------------------------------------------

# --- Anthropic SDK (OPTIONAL — see Admin → LLM access) ----------------------
# The LLM key is connected in the admin UI after the first admin exists
# (Admin → LLM access) and stored encrypted in the per-plugin vault (one
# slot each for orchestrator, orchestrator-extras, verifier). The ENV var
# below is still honoured for backwards compatibility — when set on a
# cold boot, the bootstrap migrates it into the vault and then ignores it
# on subsequent boots. New deployments should leave this blank. (The
# first-user /setup wizard stopped asking for the key in S4.)
# ANTHROPIC_API_KEY=sk-ant-...
# A class ref (class:frontier | class:balanced | class:fast), an alias
# (opus/sonnet/haiku) or a concrete vendor id. Class refs follow the live
# model catalog, which is refreshed from each provider's list-models API.
ORCHESTRATOR_MODEL=class:frontier
ORCHESTRATOR_MAX_TOKENS=4096

# --- Per-turn model routing (Haiku triage) ----------------------------------
# When ON, a cheap Haiku classifier picks the model per turn: simple turns run
# on the simple model (default class:balanced), complex turns on the complex model
# (default = ORCHESTRATOR_MODEL). Seeded into the orchestrator plugin config on
# first boot; afterwards toggle it live via Admin → Konfiguration. The *_MODEL
# overrides are optional — leave unset to use the defaults.
ORCHESTRATOR_MODEL_ROUTING=true
# MODEL_ROUTING_CLASSIFIER_MODEL=claude-haiku-4-5
# MODEL_ROUTING_SIMPLE_MODEL=class:balanced
# MODEL_ROUTING_COMPLEX_MODEL=class:frontier

# --- Sub-agent runtime ------------------------------------------------------
# Sub-agents run as local tool-loops in this process. Set SUB_AGENT_MODEL to
# a cheaper class (class:balanced / class:fast) to keep costs down while the
# orchestrator stays on the frontier class.
SUB_AGENT_MODEL=class:balanced
# LLM_MODEL_DISCOVERY_INTERVAL_MS=21600000   # re-read provider model lists every 6h (0 = boot only)
SUB_AGENT_MAX_TOKENS=4096
SUB_AGENT_MAX_ITERATIONS=16
SKILLS_DIR=../skills

# --- Persistence ------------------------------------------------------------
# Memory backend: postgres (when DATABASE_URL is set, the default) persists in
# the knowledge-graph Postgres; inmemory (no DB) is RAM-only and resets on
# restart. There is no on-disk memory store. Override with MEMORY_BACKEND=
# postgres|inmemory only to force a choice; unset auto-derives from DATABASE_URL.
#
# UPLOADED_PACKAGES_DIR: leave UNSET in any Docker/Fly deployment — when
# PLATFORM_DATA_DIR is set (e.g. /data on a volume) it defaults UNDER it so
# uploaded plugins survive `docker compose up --build`. Setting it explicitly
# pins it to the image layer, which gets wiped on every rebuild.
MEMORY_SEED_DIR=./seed/memory
# missing | overwrite | skip
MEMORY_SEED_MODE=missing

# CLI_TOOLS_DIR: npm --prefix used by the in-app "install CLI" action on the
# Subscription-CLIs admin page (runtime install of claude/codex/gemini — the
# public image deliberately does not bundle them). Leave UNSET in Docker/Fly:
# it defaults to <PLATFORM_DATA_DIR>/cli-tools on the persisted volume, so an
# installed CLI survives restarts. Local dev default: ./data/cli-tools.
# CLI_TOOLS_DIR=/data/cli-tools
#
# CODEX_HOME: where the OpenAI Codex CLI keeps auth.json after `codex login`.
# Point it at the persisted volume (mirrors CLAUDE_CONFIG_DIR) so a codex
# subscription login survives restarts.
# CODEX_HOME=/data/codex-cli

# --- Knowledge graph (Postgres + pgvector) ----------------------------------
# When DATABASE_URL is set, the middleware persists the knowledge + agentic
# graph in Postgres (schema auto-migrates on startup), and the routines +
# verifier-store features come online. Leave empty to fall back to the
# in-memory store (tests + zero-config dev).
#
# When you run the full docker-compose stack, this value is overridden to
# `postgresql://omadia:omadia@postgres:5432/omadia` so the middleware
# reaches the in-network Postgres + pgvector service. The default below is
# the matching localhost URL for running `npm run dev` outside compose.
DATABASE_URL=postgresql://omadia:omadia@localhost:5432/omadia
# Optional: `1` (or `true`) makes every pool the middleware opens accept only
# a completed SCRAM-SHA-256 exchange. A server that asks for a cleartext or MD5
# password, or lets the connection in without authentication, is refused
# before the password or any query is sent. The desktop app sets it for its
# embedded Postgres. Unset (the default), pg answers whatever the server asks.
# OMADIA_DB_REQUIRE_SCRAM=1
# Optional — tag every node/edge with a tenant scope. Default: `default`.
GRAPH_TENANT_ID=default

# --- Answer verifier (optional) ---------------------------------------------
# Checks an answer against the knowledge graph and the source systems when one
# of its trigger patterns matches: euro amounts, accounting references,
# yyyy-mm-dd and dd.mm.yyyy dates, percentages, hour and day counts, and an
# aggregate keyword (Summe, total, ...) in an answer with a number of three or
# more digits. No claim of any other answer is checked, and `enforce` delivers
# it unchecked unless one of the checks that need no claim extraction blocks it.
# Seeded into the @omadia/verifier plugin config on FIRST boot only; afterwards
# change the plugin's settings in the admin UI.
# `shadow` only records verdicts; `enforce` withholds an answer it could not
# confirm and, on a contradiction, runs at most one correction retry first:
# none on canvas streams, none with VERIFIER_MAX_RETRIES=0 (2 still runs only
# one), and none when, behind the Privacy Shield, masking would change the
# correction hint. On a borderline verdict `enforce` also draws a second
# sample of the answer, on the non-streaming path only;
# VERIFIER_RESAMPLE_ON_BORDERLINE=false switches that off. Both re-generate the
# answer over the first run's tool results: they replay every recorded
# external call and execute none of them again (a sub-agent that interned data
# behind the shield runs again, its own calls replayed).
# VERIFIER_ENABLED=false
# VERIFIER_MODE=shadow
# VERIFIER_MAX_RETRIES=1
# VERIFIER_RESAMPLE_ON_BORDERLINE=true

# --- Admin endpoint (optional) ----------------------------------------------
# When set, mounts /api/admin for memory inspection/maintenance.
ADMIN_TOKEN=

# --- First-user setup (one-shot) --------------------------------------------
# A fresh install has no admin. The first one is created either by the
# /setup wizard in the admin UI or from the ADMIN_BOOTSTRAP_* values below.
# Both are one-shot: once any user exists, both refuse.
#
# The wizard only accepts the operator's setup token (field "Setup token").
# Leave ADMIN_SETUP_TOKEN unset and the middleware generates one at start,
# stores it so every replica and restart shares it until the first admin
# exists, and prints it once per start to its log — look for "setup token:"
# (Docker: `docker compose logs middleware`). Or set your own here: at least
# 16 characters (at most 512), e.g. `openssl rand -base64 24`. An empty value
# means unset; a shorter or longer one stops the boot with a config error.
# Set it explicitly when you want to know the value before the first start.
# ADMIN_SETUP_TOKEN=
#
# The only install without a token is the desktop app: its supervisor sets
# OMADIA_DESKTOP_EMBEDDED=true AND binds the kernel to loopback. Both halves
# are required — HOST=127.0.0.1 alone still needs the token, because a
# reverse proxy on the same host makes a loopback kernel public. Do not set
# OMADIA_DESKTOP_EMBEDDED on a server.
# HOST=::
# OMADIA_DESKTOP_EMBEDDED=false
#
# Declarative seed instead of the wizard: with the users table empty and both
# EMAIL and PASSWORD (8 to 1024 characters) set, the first boot creates this
# admin. A shorter password falls back to the wizard; a longer one stops the
# boot before any account is created, because sign-in would refuse it.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_DISPLAY_NAME=

# --- Admin UI sign-in session (#965) ----------------------------------------
# Every sign-in grants a 4h session window. Shortly before it ends the UI
# offers "I'm still here", which renews the window without a new sign-in.
# Renewals stop this many hours after the ORIGINAL sign-in; after that the
# operator has to sign in again. Allowed range 4..168, default 12.
# Sign-out, an admin password reset, disabling and deleting a user end that
# user's sessions immediately, regardless of this cap (users.session_version).
# A sign-out the server cannot record answers 503 and keeps the session.
# AUTH_SESSION_MAX_LIFETIME_HOURS=12
#
# Open canvas WebSockets: a frame reaches the channel only if the session was
# confirmed at most this many ms before the frame arrived; otherwise the
# users row is read again first (one point read) while the frame waits. This
# is how fast a sign-out on another replica stops a busy socket (a socket
# that sends nothing is re-checked every 60 s). While the row cannot be read,
# frames are refused and the socket stays open. 0 = check every frame.
# Allowed range 0..60000, default 5000.
# WS_SESSION_FRAME_RECHECK_MS=5000

# --- Request trust boundary (#1310) -----------------------------------------
# Which hops in front of this process may speak for the client. This becomes
# Express's `trust proxy`, so it decides whether req.secure / req.protocol /
# req.hostname / req.ip believe a request's X-Forwarded-* headers — and with
# them whether the session and login-device cookies get the Secure flag.
# Empty (the default) trusts no hop: nothing forwarded is believed, and Secure
# follows the TLS state of the connection this process accepted.
#
# NOT a hop count. Express counts trusted hops from the server INCLUDING the
# immediate peer, so `1` trusts a client that connects directly and believes
# the X-Forwarded-Proto it sent for itself. Boot rejects a bare number.
#   <address>      the proxy in front of this process: the web-ui container's
#                  address, your Caddy/Traefik/nginx, the platform edge. One
#                  entry per hop that may set X-Forwarded-Proto; comma-separated.
#   <address>/<n>  the same as a block, when the proxy's address is not fixed
#                  (a compose network: 172.18.0.0/16).
#   loopback       127.0.0.0/8 and ::1 — the desktop install, where the shell
#   linklocal      really is the proxy. CAUTION: anything else that reaches
#   uniquelocal    this process from inside the named range is then trusted
#                  too, because it is indistinguishable from the real proxy.
#                  Name the single address where you can.
# Check it: send a login over plain HTTP with `-H 'x-forwarded-proto: https'`
# from somewhere that is NOT a named proxy. The Set-Cookie lines must carry no
# Secure. Through the real proxy over HTTPS they must carry it.
# TRUSTED_PROXY_ADDRESSES=
#
# The scheme clients reach this deployment over. Governs every scheme-shaped
# decision in the process: the Secure flag on the session, login-device and
# OIDC PKCE cookies, and the https/wss URLs the pairing descriptor hands out.
# One setting rather than a cookie-only flag, because a deployment that
# declares HTTPS for its cookies must advertise HTTPS in its pairing URLs too
# — a ws:// URL on an HTTPS page is blocked as mixed content.
#   auto   follow the connection (default): req.secure, which applies
#          X-Forwarded-Proto only from the hops named above.
#   https  clients reach us over TLS whatever this process can observe. The
#          answer for a reverse proxy that terminates TLS but sets NO
#          X-Forwarded-Proto: `auto` cannot tell that apart from genuine plain
#          HTTP and leaves the flag off, and trusting the header from every
#          sender is the bug this replaced. Set it only when every path in is
#          HTTPS — a browser discards a Secure cookie sent over HTTP, which
#          looks like a login that silently does nothing.
#   http   plain HTTP on purpose, with no doubt about it.
# PUBLIC_SCHEME=auto
#
# Read by the WEB-UI process, not this one. The /bot-api proxy states
# X-Forwarded-Proto itself and drops the browser's value, so a browser cannot
# pick the scheme the middleware believes. It is a DECLARATION, not a
# derivation: a Next Route Handler cannot observe its own TLS state (there is
# no socket on NextRequest, and req.nextUrl.protocol is built by next FROM that
# same header, so deriving from it would launder the browser's value back in).
#   http          the default. Right wherever the browser reaches the web-ui
#                 directly, including this compose stack.
#   https         the web-ui sits behind a TLS-terminating edge (Fly, Render).
#   trust-header  relay the incoming value; you assert only a trusted edge can
#                 set it.
# WEB_UI_PUBLIC_SCHEME=http
#
# --- Admin UI sign-in rate limit --------------------------------------------
# Password sign-in (POST /api/v1/auth/login/local) runs through three limits,
# in-memory and per process (a restart clears them; N replicas allow N times
# as much). Refusals answer 429 auth.rate_limited or 503 auth.busy with a
# Retry-After header. See docs/security-architecture.md §10m.
#   - per client address: 100 failed sign-ins in a burst, then one every 6 s.
#     Only for an address a trusted proxy vouched for (xff:<n>,
#     header:<name> below). The socket address is a proxy all browsers
#     share, so one sender filling its budget would lock out everyone; it
#     is not braked as one client;
#   - per account AND client: 5 free failures, then a wait that doubles from
#     1 s up to 2 min. A success resets it, and so does an admin's password
#     reset or re-enable. Every spelling of an address (letter case, accents,
#     compatibility forms) is that one account;
#   - process-wide: AUTH_LOGIN_MAX_INFLIGHT argon2 runs at once and 300
#     attempts per minute. Browsers without a device cookie can never take
#     the last slot or the last 60 of those, so a known browser finds room.
# A browser that has signed in to an account with its password holds a
# device cookie for that account, set once per sign-in; a session alone
# sets none. The account's known browsers share a budget of their own,
# which no other browser's wrong guesses or floods can use up. The cookie
# is tied to the password its sign-in checked: a reset, a disable or a
# delete ends it, also for a sign-in still being checked when the reset
# landed.
# A browser without one shares its client address's budget — see the
# residual risks in §10m, and set a client address below that tells clients
# apart.
#
# Where the "client" address comes from. Never the left-most X-Forwarded-For
# entry: the client writes that one.
#   socket         the TCP peer. Cannot be forged, and the right choice when
#                  nothing in front of the web-ui adds the client's address:
#                  the desktop app, and the docker-compose stack reached
#                  directly. The web-ui /bot-api proxy passes the browser's
#                  X-Forwarded-For through as-is (Next.js only fills it in
#                  when it is absent), so on its own it is not a trusted hop.
#                  Every browser then shares the web-ui container's address.
#   xff:<n>        the n-th X-Forwarded-For entry from the RIGHT. Set n to the
#                  number of trusted proxies that APPEND the client's address
#                  to the header in front of the web-ui (and of the
#                  middleware, if it is reachable directly). Compose behind
#                  Caddy or Traefik (both append by default) or nginx with
#                  `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`:
#                  xff:1 — but only if every request reaches web-ui through
#                  that proxy. A wrong n on a path without that many honest
#                  hops lets a client pick its own key. Check it: send six
#                  wrong sign-ins through the proxy with a made-up
#                  X-Forwarded-For value; the "[auth] login refused" log line
#                  must name your real address, not the made-up one.
#   header:<name>  a header your edge SETS and overwrites. Fly.io:
#                  header:Fly-Client-IP (fly/middleware.fly.toml sets it) —
#                  not xff:1, because Fly puts the app's own IP address
#                  right-most in X-Forwarded-For, which would give every
#                  client the same key. Cloudflare: header:CF-Connecting-IP,
#                  but only if the app cannot be reached around Cloudflare.
# AUTH_LOGIN_CLIENT_ADDRESS=socket
#
# IPv6 clients are keyed by this many leading bits of their address (32..64,
# default 64: a host controls its whole /64). A /56 holds 256 /64s and a /48
# holds 65,536, each a client key of its own at 64. 56 or 48 folds such an
# allocation into one key, but also lumps together unrelated clients that
# share one (a carrier, a hosting provider's /48).
# AUTH_LOGIN_IPV6_PREFIX=64
#
# Concurrent argon2 verifications (sign-in and the setup wizard's hash)
# before further attempts get 503 auth.busy; one of them is kept for browsers
# with a device cookie (none when this is 1). Each takes 19 MiB and a thread
# of Node's libuv pool (UV_THREADPOOL_SIZE, default 4), so more slots than
# pool threads only queue. Allowed 1..16, default 4.
# AUTH_LOGIN_MAX_INFLIGHT=4

# --- Dev endpoints (LOCAL ONLY) ---------------------------------------------
# Mounts unauthenticated /api/dev/graph + /api/dev/memory for the Graph +
# Memory viewers in the admin UI. Off by default — these routes expose raw
# memory + KG state without auth, so a fresh clone that gets reused as a
# starting point for a non-local deploy stays safe. Uncomment when you want
# the admin Graph/Memory tabs against your local middleware (the loopback-
# only docker-compose stack also reads this variable). NEVER set this on a
# public deployment.
# DEV_ENDPOINTS_ENABLED=true

# --- Runtime ----------------------------------------------------------------
MAX_TOOL_ITERATIONS=12
PORT=8080

# --- Diagram rendering (Kroki + S3-compatible storage) — OPTIONAL -----------
# Diagrams are OFF by default. The plugin activates only when KROKI_BASE_URL,
# DIAGRAM_URL_SECRET, BUCKET_NAME and AWS_ENDPOINT_URL_S3 are all set; then the
# orchestrator exposes the `render_diagram` tool and serves signed PNG URLs at
# /diagrams/<key>.
#   With Docker: enable via the compose overlays (docker-compose.storage.yaml +
#   docker-compose.diagrams.yaml). They set KROKI_BASE_URL / BUCKET_NAME / AWS_*
#   to the in-network service names for you — the only value you set HERE is the
#   signing secret below.
#   Bare-metal `npm run dev`: also uncomment KROKI_BASE_URL + the object-storage
#   block below and point them at your local services.
# KROKI_BASE_URL=http://localhost:8765
# openssl rand -hex 32   (32+ random bytes; never share; rotate on leak)
DIAGRAM_URL_SECRET=
# Public base URL signed image URLs are issued under. For local dev this is
# the middleware on :8080.
DIAGRAM_PUBLIC_BASE_URL=http://localhost:8080

# --- Plugin credential flows (spec 004) -------------------------------------
# Browser-facing origin that plugin OAuth/credential flow callbacks resolve
# against (ctx.flows.publicUrl). Defaults to PUBLIC_BASE_URL — set this only
# when flow callbacks must land on a different origin than the admin UI (rare).
# FLOW_PUBLIC_BASE_URL=https://omadia.example.com

# --- Generic MCP-server OAuth (epic #459 W9) --------------------------------
# Absolute redirect URI the MCP OAuth callback (Notion, etc.) lands on after
# the provider's consent screen. Defaults to
# FLOW_PUBLIC_BASE_URL/api/v1/operator/mcp-oauth/callback — but that default
# only resolves correctly when FLOW_PUBLIC_BASE_URL/PUBLIC_BASE_URL already
# points AT the middleware directly (true on Fly, where PUBLIC_BASE_URL is
# the middleware's own public host). It is WRONG whenever the public origin
# is web-ui in front of the middleware (local dev): web-ui's Next server only
# rewrites `/bot-api/*` to the middleware — `/api/*` is reserved for Next's
# own routes and is NOT proxied, so the raw `/api/...` default 404s there.
# Mirrors the AUTH_REDIRECT_URI precedent: in dev, route the callback through
# the `/bot-api` prefix on web-ui's origin so Next's rewrite forwards it.
#   Local dev:  http://localhost:3000/bot-api/v1/operator/mcp-oauth/callback
#   Fly/prod:   leave unset — the PUBLIC_BASE_URL-derived default is correct
#               once PUBLIC_BASE_URL is the middleware's own public host.
# MCP_OAUTH_REDIRECT_URI=http://localhost:3000/bot-api/v1/operator/mcp-oauth/callback

# --- MCP tool-list caching (issue #545, ADR-0009) ----------------------------
# TTL (ms) applied to a cached `tools/list` result when the remote server sends
# no `ttlMs` of its own (MCP 2026-07-28 CacheableResult). Server-provided TTLs
# are honoured but clamped to 15 minutes. `0` = spec-strict: never cache a
# list without an explicit server `ttlMs`. Read per listing — a change applies
# without a restart. Discovery and the security rescan always bypass the cache.
# OMADIA_MCP_TOOLLIST_TTL_MS=60000

# --- In-app "Create Issue" button (operator GitHub device flow) -------------
# Lets an operator connect their OWN GitHub account and file issues to the
# public repo (byte5ai/omadia) as themselves. Uses GitHub's DEVICE FLOW, so
# only a PUBLIC client id is needed — there is NO client secret. The client
# id is normally baked into the product (issues/githubOAuthProvider.ts:
# DEFAULT_GITHUB_CLIENT_ID); set this var only to OVERRIDE it per deployment.
#
# To enable: register a GitHub OAuth App (Settings > Developer settings >
# OAuth Apps), tick "Enable Device Flow", and use scope `public_repo`. No
# callback URL is required for the device flow.
# GITHUB_OAUTH_CLIENT_ID=Ov23lixxxxxxxxxxxxxx

# Object-storage credentials — OPTIONAL (chat attachments + diagrams/office).
# OFF by default. With Docker, docker-compose.storage.yaml sets these to the
# in-network MinIO for you. For bare-metal dev, uncomment and point at your
# S3/MinIO. (Leave commented for the minimal Docker core, otherwise the kernel
# wires an object store it can't reach from inside the container.)
# BUCKET_NAME=diagrams
# AWS_ENDPOINT_URL_S3=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# Local attachment store — OPTIONAL, for a single-machine install without S3.
# Used only when the four object-storage values above are NOT all set (S3 wins
# otherwise) and published under the same `tigrisStore` service, so Teams
# attachment persistence and the orchestrator's attachment reader work against
# it. Objects are stored owner-only under <dir>/<2 hex>/<sha256 of the key>;
# nothing expires them (an S3 bucket gets a 90-day lifecycle rule). One
# instance per directory. /health reports the live store as
# `attachments.store` ('s3' | 'filesystem' | 'none'). The desktop app sets this
# into its data folder when the setup wizard's "Attachments" switch is on.
# Relative paths resolve against the middleware directory.
# ATTACHMENT_STORE_DIR=./data/attachments

# --- Topic detection (Ollama sidecar for in-tenant embeddings) — OPTIONAL ---
# Embeddings are OFF by default (the KG runs FTS-only, no topic detection).
# When OLLAMA_BASE_URL is set, the orchestrator also classifies follow-ups to
# decide "same topic / new topic / ask the user".
#   With Docker: enable via docker-compose.embeddings.yaml (it sets
#   OLLAMA_BASE_URL to the in-network sidecar for you).
#   Bare-metal dev: uncomment the two lines below.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
TOPIC_CLASSIFIER_MODEL=claude-haiku-4-5
# Similarity thresholds — tune carefully. Above upper = auto continue,
# below lower = auto reset, in-between = escalate to a classifier turn.
TOPIC_UPPER_THRESHOLD=0.55
TOPIC_LOWER_THRESHOLD=0.15

# --- Plugin code scanning (SkillSpector sidecar, issue #453) — OPTIONAL -----
# Advisory static scan of every ingested plugin package (upload, hub install,
# Builder install). OFF by default: without SKILLSPECTOR_URL nothing scans,
# installs behave unchanged, and NO verdict rows are written (store pages
# show no badge); `scan_failed` is reserved for real sidecar failures. A
# verdict NEVER blocks an install in v1 — it decorates the store detail page.
#   With Docker: enable via docker-compose.skillspector.yaml (it builds
#   middleware/sidecars/skillspector and sets the URL for you).
#   Bare-metal dev: run the sidecar yourself and uncomment below.
# SKILLSPECTOR_URL=http://localhost:8811
# SKILLSPECTOR_TIMEOUT_MS=20000

# --- Bundled plugin-id override (issue #789) — OPTIONAL, LEAVE UNSET --------
# An uploaded package whose `identity.id` matches a plugin this image SHIPS
# (`middleware/packages/*`) is refused at ingest with
# `package.id_conflict_bundled`. The refusal exists because a plugin id is not
# a credential: the dated legacy service-grant ramp is keyed by id, so a zip
# claiming e.g. `@omadia/orchestrator` would otherwise inherit that id's
# grandfathered capabilities — `graphPool` (the operator's Postgres pool) and
# `tigrisStore` among them — without declaring any of them.
# Setting this to exactly `1` allows such an upload. It does NOT grant the
# package the bundled plugin's legacy rows: the grant gate keys those on the
# catalog `origin` the loader stamped, and an upload is never `bundled`.
# Only for operators deliberately shadowing a shipped plugin with a patched
# build of their own. Any other value (including `true`) leaves the gate armed.
# PLUGIN_ALLOW_BUNDLED_ID_OVERRIDE=1

# --- Privacy Shield org clamp (OPTIONAL) -------------------------------------
# The `_privacy_mode` setting of every plugin that contributes tools defaults
# to `guarded`. The shield acts only in a turn's own model requests (the
# agent's model loop, its sub-agents and the verifier's requests about the
# answer). There a tool's result is interned and the model sees an
# identity-free digest, and the error of a tool that is not bypassed is
# redacted or withheld. Intern-exempt tools such as `read_attachment` hand the
# model their results as they are, but not their errors
# (docs/security-architecture.md §6f). Prompt text, the chat history a
# channel replays included, is masked there only while `mask_user_prompt`
# (privacy guard settings, default off) is on. Every other model call sends
# its text as it is, among them the inbound security screener, the memory
# jobs and plugin `ctx.llm` calls, and attached images reach the model
# unmasked in any request (§6f). An operator can set a plugin to `bypass` or
# `per_tool`, or flag an MCP server for privacy bypass. Exactly `true` here
# clamps all of them back to `guarded` for the results the model gets,
# whatever their setting says, and for the MCP-to-knowledge-graph ingestion
# (epic #459): an MCP server flagged for both knowledge-graph ingestion and
# privacy bypass then stores a value-free note of each result's shape instead
# of up to 8,000 characters of the raw result. It changes only that mode
# selection: it
# does not close the §6f exceptions, does not switch on prompt masking and
# does not reach agents on the Claude subscription CLI (`claude-cli`), which
# run without the shield (docs/security-architecture.md §3a).
# OMADIA_PRIVACY_FORCE_GUARDED=true

# --- Prompt-PII C1 detector (GLiNER sidecar, issue #361) — OPTIONAL ---------
# Transformer-based multilingual PII detection (person names, free-form
# addresses) for the privacy guard — the C1 tier on top of the C0 regex
# baseline. OFF by default: without this URL no C1 call is attempted and
# every privacy-guard path runs C0-only. If the sidecar fails at runtime, C1
# is off for the rest of that turn and every path runs on C0 and the
# deny-list alone (logged as `promptMaskDegraded`, `toolErrorRedactDegraded`),
# so names only C1 detects reach the model unmasked; no text skips C0. With
# prompt masking on, only a failure of C0 itself blocks a request (§6f of
# docs/security-architecture.md). The sidecar receives raw text: the
# turn's prompt text while `mask_user_prompt` is on and, regardless of that
# flag, tool-error text and every evidence-judge request of the answer
# verifier (the restored claim plus knowledge-graph evidence). Keep it
# internal-network-only, never public.
#   With Docker: enable via docker-compose.pii-detector.yaml (it builds
#   middleware/sidecars/pii-detector and sets the URL for you).
#   Bare-metal dev: run the sidecar yourself and uncomment below.
# PRIVACY_C1_DETECTOR_URL=http://localhost:8812

# --- Vault (encrypted secrets store) ----------------------------------------
# Master key used to AES-256-GCM-encrypt plugin secrets at rest under
# /data/vault. Generate once with `openssl rand -base64 32` and keep stable
# across deployments — losing it makes vault entries unrecoverable.
#
# Leave empty to let the middleware auto-generate a key in /data/.dev-vault.key
# (DEV ONLY — the compose stack pins NODE_ENV=development so this path is
# available out of the box). The shipped image bakes NODE_ENV=production
# and refuses to boot without VAULT_KEY set; any production deployment
# (Fly, K8s, bare VM) MUST supply this as a secret before first boot.
VAULT_KEY=

# Dataset link keys. Every string column of an uploaded CSV/XLSX gets a
# `__k_<column>` companion: HMAC-SHA256(secret, user-id + normalised raw value),
# 16 hex chars — a stable, identity-free per-person key that lets the Privacy
# Shield v4 verbs (`v4_union` / `v4_distinct` / `v4_join`) de-duplicate and
# match people ACROSS a user's uploads without ever seeing a name. Leave empty
# to derive the key from VAULT_KEY (HKDF, label `omadia/dataset-link-key/v1`):
# note that this gives VAULT_KEY a second job — rotating it re-keys link keys,
# so datasets imported before and after the rotation no longer link. Set this
# explicitly (>= 16 chars, `openssl rand -hex 32`) to decouple the two. With
# neither set, uploads get no `__k_*` columns and the import notice says so.
#
# The SAME secret (separate HKDF label) also encrypts PII cells of uploaded
# tables at rest (AES-256-GCM, `enc1:…`): real values stay recoverable for the
# entitled user — render + Excel export — while the model only ever sees a
# digest. ROTATING THIS SECRET (or VAULT_KEY when this is empty) makes every
# previously imported encrypted cell unreadable (`[verschlüsselt — Schlüssel
# nicht verfügbar]`); re-upload the files afterwards. Without any secret,
# flagged cells are masked irreversibly as before and exports show surrogates.
DATASET_LINK_KEY_SECRET=

# Credential-keychain master key (#578/#778). Encrypts the credential keychain
# (per-user connector credentials) — a DIFFERENT trust domain than the vault,
# so never reuse the VAULT_KEY value. Same shape (`openssl rand -base64 32`),
# same dev fallback (/data/.dev-credential-keychain.key), same production rule:
# since v0.115 the middleware refuses to boot under NODE_ENV=production without
# it. Rolling updates on a production instance that lacks this key fail the
# health gate and roll back.
CREDENTIAL_KEYCHAIN_KEY=

# --- Dev platform -----------------------------------------------------------
# The Dev Platform is no longer part of core. It ships as an installable plugin
# — install it from the plugin hub at https://hub.omadia.ai (or by ZIP upload)
# and configure it through the plugin's own settings rather
# than through middleware environment variables. Every key that used to live
# here is now a plugin setting; none of them are read by the middleware.

# --- Turn receipts (#757) ---------------------------------------------------
# Every completed turn with privacy-shield activity (interned data, a bypass,
# a connected tool's structured output, a masked prompt, a tool error whose
# text was withheld or redacted, or an answer-verifier request sent under the
# turn's privacy view) persists its PII-free privacy receipt (turn_receipts,
# Postgres backend only); turns without it write none (#1081). turn_id + scope
# are personal-data linkage, so rows are reaped after this many days.
RECEIPT_RETENTION_DAYS=90

# --- Receipt hash chain checkpoints (#758) ----------------------------------
# Ed25519 private key (base64 PKCS#8 DER) for signing chain checkpoints —
# generate with `node scripts/generate-audit-signing-key.mjs`. Keep it in a
# secret manager / env, NEVER in the database. Absent = chain builds, no
# signed checkpoints (logged loudly at boot).
# AUDIT_SIGNING_KEY=
AUDIT_CHECKPOINT_INTERVAL_MINUTES=60
# Optional external anchor file (JSONL, append-only) outside the DB — point
# at storage the DB admin cannot rewrite (WORM / synced bucket).
# AUDIT_ANCHOR_PATH=/data/audit-anchors.jsonl

# --- Conductor generic webhooks (issue #437) --------------------------------
# Global kill switch for the inbound POST /api/hooks/:endpointId route. Every
# endpoint is ALSO gated by its own per-endpoint HMAC secret (Vault-backed,
# rotatable via the operator API) — this is the "off unless an operator opted
# in" belt-and-braces switch. Outbound subscriptions have no separate flag: an
# operator who creates one has already opted in.
CONDUCTOR_WEBHOOKS_ENABLED=true
# Per-endpoint rate limit (rolling minute) enforced atomically alongside the
# delivery-id dedupe — bounds how many workflow runs one endpoint can start even
# though a correctly-signed sender can mint a fresh delivery id on every call.
CONDUCTOR_WEBHOOK_MAX_DELIVERIES_PER_MINUTE=60
# Optional — base URL the operator UI shows for the inbound endpoint URL
# (/api/hooks/:endpointId). Falls back to PUBLIC_BASE_URL when unset. Set this
# explicitly if PUBLIC_BASE_URL points at the Next.js dev-server origin (which
# does not proxy /api/hooks/*, only /bot-api/*) rather than the middleware itself.
# CONDUCTOR_WEBHOOK_PUBLIC_BASE_URL=http://localhost:3979

# --- Conductor ephemeral / JIT workflows (#330 Workstream A) -----------------
# Guardrails for agent-generated workflows (conductor.createEphemeralRun):
# a mandatory TTL (requested values are clamped to the max), per-agent caps on
# concurrent ephemeral runs and creations per hour, and the reaper poll that
# disposes of expired/terminal scaffolds while retaining the run's audit trace.
CONDUCTOR_EPHEMERAL_DEFAULT_TTL_MS=86400000
CONDUCTOR_EPHEMERAL_MAX_TTL_MS=604800000
CONDUCTOR_EPHEMERAL_MAX_ACTIVE_PER_AGENT=3
CONDUCTOR_EPHEMERAL_MAX_CREATES_PER_HOUR=10
CONDUCTOR_EPHEMERAL_REAPER_INTERVAL_MS=60000

# --- Realtime transcription (#584, EXPERIMENTAL) ----------------------------
# Enables the `gpt-live-transcribe` realtime path of the OpenAI transcription
# adapter (`transcription@1` capability, transcribeStream over the Realtime
# WebSocket, $0.017/min). OFF by default: its only real consumer — the
# AudioMeetingSource of #584 Workstream S — is a follow-up, so no production
# path should open a live transcription socket yet. The batch path
# (`gpt-transcribe`, transcribeFile) is always available once the adapter
# plugin is installed and holds an API key.
# TRANSCRIPTION_REALTIME_EXPERIMENTAL=1

# --- Sign in with ChatGPT (#294, EXPERIMENTAL) ------------------------------
# Registers the `openai-chatgpt` subscription provider: connect via an OAuth
# device flow ("Sign in with ChatGPT") on the Modelle admin page instead of an
# API key. The resulting bearer targets the ChatGPT/Codex Responses backend.
# OFF by default — driving programmatic calls through a consumer ChatGPT
# subscription is a ToS grey area; opt in explicitly and surface the notice.
# CHATGPT_SUBSCRIPTION_EXPERIMENTAL=true

# --- LAN pairing (mDNS, #293) -----------------------------------------------
# Advertise `_omadia._tcp` so a desktop client on the same network can find this
# kernel. Default true for self-hosters; the desktop app passes false because on
# a single-user machine there is nothing to discover (OM-70, #1004).
# OMADIA_UI_MDNS_ENABLED=true

# --- Test switches for the subscription-CLI gate (#1017) ---------------------
# Neither is read by the running middleware; both only gate test behaviour, and
# they live here because AGENTS.md wants every env var documented in one place.
#
# Makes the loopback MCP tests FAIL instead of self-skipping when the sandbox
# refuses a 127.0.0.1 listener. Without it a runner that cannot listen reports
# the whole file green while asserting nothing. CI sets it.
# OMADIA_EXPECT_LOOPBACK=1
#
# Runs the live CLI gate probe: spawns the real `claude` with the production
# argv and asks it to run a shell command, which must be refused. Costs
# subscription quota and needs a logged-in CLI, so it is opt-in.
# OMADIA_CLI_LIVE_PROBE=1
#
# Adds the negative control to that probe: the pre-#991 argv, which is expected
# to reach a built-in tool. Deliberately lets the CLI run a shell command on
# this machine, so it has its own switch.
# OMADIA_CLI_NEGATIVE_CONTROL=1

# --- Test switch for the desktop's embedded Postgres ------------------------
# Not read by the middleware or the desktop app: only the desktop integration
# test (desktop/test/embeddedDb.integration.test.mts) reads it, and it lives
# here for the same reason as the switches above.
#
# Makes that test FAIL instead of skipping when desktop/node_modules holds no
# @embedded-postgres engine for this platform or the test runs as root (initdb
# refuses root), and instead of leaving its pgvector assertions out when no
# pgvector is staged into the engine. Without it such a runner reports the
# file green while checking less, or nothing. Only the value `require` counts.
# The desktop-apps workflow sets it on macOS and Linux after staging pgvector.
# OMADIA_EMBEDDED_PG_IT=require

# --- Keyless embedder: where the model weights live (OM-97) -----------------
# The ~129 MB of weights for @omadia/embedding-adapter-local. NOT read through
# config.ts — the plugin resolves it itself, so it has no zod schema.
#
# Resolution order, most explicit first:
#   1. the plugin's own `model_dir` setup field (Admin -> Plugins);
#   2. OMADIA_EMBEDDING_MODEL_DIR — this variable, what the desktop shell sets;
#   3. PLATFORM_DATA_DIR/embedding-models — the kernel's data-volume
#      convention, which a Docker or Fly deployment already mounts and backs up;
#   4. the legacy, RELATIVE `var/embedding-models`.
#
# WHY IT EXISTS. (4) resolves against the middleware's working directory, which
# in the desktop app is `<app bundle>/Resources/omadia/middleware` — INSIDE the
# signed application. Downloading the weights there succeeds and invalidates
# the macOS code signature; Gatekeeper then refuses the next launch and the
# user's only recovery is a reinstall. Model weights are mutable per-user state
# and belong with the vault and the embedded database, never in the read-only
# application bundle. Leave this unset for a plain `npm run dev` checkout — (4)
# is then correct and harmless.
# OMADIA_EMBEDDING_MODEL_DIR=/data/embedding-models

# --- Subscription-CLI turn budget (OM-104, beta round 5) ---------------------
# Wall-clock budget of ONE CLI-owned chat turn (Shape 3, `CliChatAgent`), in
# milliseconds. Default 600000 (10 min). It used to be a hard-coded 120 s with
# no override, while a single call to omadia's own `query_seo_analyst` sub-agent
# takes 69–75 s — two of those and the turn was guaranteed dead. The 60 s idle
# timeout (no output from the CLI at all) is separate and stays; this one only
# needs to be long enough for the tools a turn legitimately runs. Non-numeric
# or non-positive values are ignored, never turned into a zero budget.
# The orchestrator setup field `cli_turn_seconds` (ADMIN -> LLM-Zugang -> Abos)
# overrides this, so an operator raising the limit in the UI is not overruled
# by a stale deployment variable (setting > env > default).
# OMADIA_CLI_SPAWN_TIMEOUT_MS=600000

# --- Agent sandbox container limits (#576 execute, #581 publish) ------------
# Ceilings for every Docker container that runs agent code: the per-scope
# sandbox behind the `execute` tool and each app started by `publish`. Only
# relevant while the orchestrator's sandbox_execute_enabled or
# sandbox_publish_enabled is on. The memory value is also the RAM+swap ceiling
# (--memory-swap), so a container cannot swap past it. Accepted: memory 6 to
# 1048576 MiB (1 TiB, whole number), CPUs 0.01 to 1024, PIDs 1 to 4194304
# (whole number). There is no "unlimited": empty, 0, negative, non-numeric or
# out-of-range values are ignored and the default applies. The ranges also
# keep out values Docker would silently run without a limit, such as
# 0.000001 or 1e64 CPUs. The orchestrator setup fields sandbox_memory_mb /
# sandbox_cpus / sandbox_pids_limit override these (setting > env > default).
# New values apply to new containers, and to an existing persistent sandbox
# via `docker update` the next time it is re-attached. A sandbox container
# runs nothing until `docker inspect` shows all of these limits in force: if
# the update fails or the daemon drops a limit, the request is refused, an
# existing container is stopped and kept with its files, and a new one is
# removed. Published app containers are not checked this way yet.
# OMADIA_SANDBOX_MEMORY_MB=512
# OMADIA_SANDBOX_CPUS=1
# OMADIA_SANDBOX_PIDS_LIMIT=256

# --- Operator web-ui framing (read by the WEB-UI process, not this one) -----
# Every operator page answers with CSP frame-ancestors 'none' and
# X-Frame-Options DENY. A deployment that embeds operator pages in another site
# sets the allowed ancestors as a space-separated CSP source list; X-Frame-
# Options is then left out. Set it on the web-ui service (compose `web-ui`
# environment, the web-ui Fly app, the Render web-ui service). It is read per
# request, so a published image honours it without a rebuild. Wrap the whole
# value in double quotes: a value that starts with a single quote is parsed as
# quoted by env-file readers. Invalid values are ignored with a warning in the
# web-ui log and the default stays. /p/* and /bot-api/* keep the middleware's
# own headers either way. Documented here because AGENTS.md wants every env
# var in one place.
# UI_FRAME_ANCESTORS="'self' https://teams.microsoft.com https://*.teams.microsoft.com"
