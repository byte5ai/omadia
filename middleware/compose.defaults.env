# Defaults for the middleware service of the docker-compose stack (#1317).
#
# docker-compose.yaml loads this file BEFORE middleware/.env, so any value you
# set in middleware/.env wins. Do not edit this file to change a value; set it
# in middleware/.env instead.
#
# The four values are fixed, not derived from each other: when you move the
# stack behind another origin (a reverse proxy, a real hostname), set
# PUBLIC_BASE_URL AND the three URLs below it in middleware/.env. Overriding
# PUBLIC_BASE_URL alone leaves the callbacks on localhost. (A value under the service's `environment:` key
# would beat both files, which is why these are not there.)
#
# The middleware's built-in default for PUBLIC_BASE_URL is
# http://localhost:3979, the port of a from-source run. Nothing listens there in
# this stack: the admin UI is on http://localhost:3333 and the middleware on
# http://localhost:8080. The URLs below point every link the middleware hands
# to a browser at the origin that serves it.

# The origin users open in the browser: the admin UI. Login redirects, the
# Entra post-logout redirect and plugin flow callbacks (/bot-api/...) resolve
# against it.
PUBLIC_BASE_URL=http://localhost:3333

# The admin UI forwards only /bot-api/* to the middleware's /api/*, never a raw
# /api/* path, so the two callbacks below go through /bot-api on the UI origin.
# Register these exact URLs with the identity provider when you use them.
AUTH_REDIRECT_URI=http://localhost:3333/bot-api/v1/auth/login/entra/cb
MCP_OAUTH_REDIRECT_URI=http://localhost:3333/bot-api/v1/operator/mcp-oauth/callback

# Conductor's inbound webhook route (/api/hooks/:endpointId) is called by
# external senders, not browsers, and lives on the middleware origin only.
CONDUCTOR_WEBHOOK_PUBLIC_BASE_URL=http://localhost:8080

# The Teams bot endpoint needs a public https:// origin, so it has no local
# default. Set TEAMS_PUBLIC_BASE_URL in middleware/.env when you connect Teams.
